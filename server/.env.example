# Copiá este archivo a server/.env. NUNCA subas el .env real. Producción: cargá estas variables en Render.
NODE_ENV=development
PORT=4000
# MongoDB Atlas: mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/jack-el-barbero  (en producción es obligatorio)
MONGO_URI=
# Origen(es) del sitio, separados por coma. Es la lista cerrada de CORS.
CLIENT_URL=http://localhost:5173
# URL pública de esta API (para los links de comprobantes y el webhook de Mercado Pago)
PUBLIC_API_URL=http://localhost:4000
# 3 secretos distintos, mínimo 16 caracteres, al azar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LINK_SECRET=
BUSINESS_UTC_OFFSET=-03:00
UPLOAD_DIR=uploads
# Mercado Pago (al final, primero credenciales de PRUEBA): ver docs/MERCADOPAGO.md
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
